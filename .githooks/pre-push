#!/bin/sh
set -eu

zero_oid=0000000000000000000000000000000000000000

verify_commit() {
    commit=$1
    if ! git verify-commit "$commit" >/dev/null 2>&1; then
        echo "error: refusing to push unsigned or unverifiable commit $commit" >&2
        exit 1
    fi
}

while read -r local_ref local_oid remote_ref remote_oid; do
    if [ "$local_oid" = "$zero_oid" ]; then
        continue
    fi
    case "$local_ref" in
        refs/heads/*)
            if [ "$remote_oid" = "$zero_oid" ]; then
                commits=$(git rev-list "$local_oid" --not --remotes)
            else
                commits=$(git rev-list "$remote_oid..$local_oid")
            fi
            for commit in $commits; do
                verify_commit "$commit"
            done
            ;;
        refs/tags/*)
            if ! git cat-file -e "$local_oid^{tag}" 2>/dev/null; then
                echo "error: refusing to push lightweight tag $local_ref" >&2
                exit 1
            fi
            if ! git verify-tag "$local_oid" >/dev/null 2>&1; then
                echo "error: refusing to push unsigned or unverifiable tag $local_ref" >&2
                exit 1
            fi
            commit=$(git rev-parse "$local_oid^{commit}")
            verify_commit "$commit"
            ;;
    esac
done

root=$(git rev-parse --show-toplevel)
cd "$root"

if [ -n "${PYTHON:-}" ]; then
    python=$PYTHON
elif [ -x .venv/bin/python ]; then
    python=.venv/bin/python
else
    python=python3
fi

make ci PYTHON="$python"
